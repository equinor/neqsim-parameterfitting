{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/equinor/neqsim-parameterfitting/schemas/density-schema.json",
  "title": "Density Experimental Data Schema",
  "description": "Schema for density experimental data files",
  "type": "object",
  "required_columns": [
    {
      "name": "id",
      "type": "integer",
      "required": true,
      "description": "Unique row identifier"
    },
    {
      "name": "component_1",
      "type": "string",
      "required": true,
      "description": "Primary component name"
    },
    {
      "name": "temperature_K",
      "type": "float",
      "required": true,
      "unit": "K",
      "description": "Temperature in Kelvin"
    },
    {
      "name": "pressure_bar",
      "type": "float",
      "required": true,
      "unit": "bar",
      "description": "Pressure in bar"
    },
    {
      "name": "density_kg_m3",
      "type": "float",
      "required": true,
      "unit": "kg/m³",
      "description": "Mass density"
    },
    {
      "name": "reference",
      "type": "string",
      "required": true,
      "description": "Literature reference"
    }
  ],
  "optional_columns": [
    {
      "name": "component_2",
      "type": "string",
      "required": false,
      "description": "Secondary component for mixtures"
    },
    {
      "name": "x1",
      "type": "float",
      "required": false,
      "unit": "mol/mol",
      "description": "Mole fraction of component 1"
    },
    {
      "name": "molar_density_mol_m3",
      "type": "float",
      "required": false,
      "unit": "mol/m³",
      "description": "Molar density"
    },
    {
      "name": "uncertainty",
      "type": "float",
      "required": false,
      "unit": "kg/m³",
      "description": "Absolute uncertainty"
    },
    {
      "name": "uncertainty_percent",
      "type": "float",
      "required": false,
      "unit": "%",
      "description": "Relative uncertainty percentage"
    },
    {
      "name": "phase",
      "type": "string",
      "required": false,
      "enum": ["liquid", "vapor", "gas", "supercritical", "two-phase"],
      "description": "Phase of the measurement"
    },
    {
      "name": "quality_flag",
      "type": "string",
      "required": false,
      "enum": ["A", "B", "C"],
      "description": "Data quality rating"
    },
    {
      "name": "doi",
      "type": "string",
      "required": false,
      "description": "DOI of source publication"
    },
    {
      "name": "notes",
      "type": "string",
      "required": false,
      "description": "Additional notes"
    }
  ],
  "validation_rules": {
    "temperature_K": {
      "minimum": 0,
      "maximum": 2000
    },
    "pressure_bar": {
      "minimum": 0,
      "maximum": 10000
    },
    "density_kg_m3": {
      "minimum": 0,
      "maximum": 25000
    },
    "x1": {
      "minimum": 0,
      "maximum": 1
    }
  }
}
